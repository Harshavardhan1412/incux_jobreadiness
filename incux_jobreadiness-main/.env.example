# -----------------------------------------------------------------
# ReadySetJob — Environment Variables Template
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit backend/.env to git.
# -----------------------------------------------------------------

# -- PostgreSQL (Railway) -----------------------------------------
# Public URL (for local development outside Railway)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>.proxy.rlwy.net:<PORT>/railway

# Internal URL (used when deployed inside Railway private network)
INTERNAL_DATABASE_URL=postgresql://postgres:<PASSWORD>@postgres.railway.internal:5432/railway

# -- Redis (Railway) ----------------------------------------------
# Public URL (for local development outside Railway)
REDIS_URL=redis://default:<PASSWORD>@<HOST>.proxy.rlwy.net:<PORT>

# Internal URL (used when deployed inside Railway private network)
# REDIS_URL=redis://default:<PASSWORD>@redis.railway.internal:6379

# -- Server -------------------------------------------------------
PORT=5000
NODE_ENV=development

# -- Auth ---------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# -- CORS ---------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# -- Code Execution Backend ---------------------------------------
# Options: judge0 (default) | piston
CODE_EXECUTOR=judge0

# Judge0 via RapidAPI (required for production)
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here

# Self-hosted Piston (recommended for scale, no daily quota)
# PISTON_URL=https://your-piston-instance.com

# Max concurrent sandbox executions globally (default: 50)
# GLOBAL_EXEC_CONCURRENCY=50

# Max parallel test cases per submission (default: 6)
# CODE_EXEC_CONCURRENCY=6
