    "html2canvas": "^1.4.1",
    "input-otp": "1.4.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "multer": "^2.0.2",
    "next-themes": "0.4.6",
    "pg": "^8.16.3",
    "react-day-picker": "8.10.1",
    "react-hook-form": "7.55.0",
    "react-resizable-panels": "2.1.7",
    "react-router": "7.13.0",
    "react-router-dom": "^7.18.0",
