    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.4",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "6.3.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
