{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"vite\" \"node --watch-path server/src server/src/index.js\"",
    "dev:web": "vite",
    "dev:server": "node --watch-path server/src server/src/index.js",
    "build": "vite build",
    "start": "node server/src/index.js",
    "test": "vitest run server/tests",
    "test:watch": "vitest server/tests",
    "debug:cwd": "node -e \"const fs=require('fs'); const p='scripts/prisma.js'; fs.writeFileSync('debug-cwd.txt', JSON.stringify({cwd:process.cwd(),exists:fs.existsSync(p),stat:fs.existsSync(p)?fs.statSync(p).size:null}))\"",
    "debug:run": "node -e \"const fs=require('fs'),cp=require('child_process'),p='scripts/prisma.js'; const r=cp.spawnSync(process.execPath,[p,'--version'],{encoding:'utf8'}); fs.writeFileSync('debug-run.json',JSON.stringify({cwd:process.cwd(),exists:fs.existsSync(p),status:r.status,error:String(r.error||''),stdout:r.stdout,stderr:r.stderr}))\"",
    "db:setup": "node ./scripts/setup-database.js",
    "db:inspect": "node ./scripts/inspect-database.js",
    "db:generate-migration": "node ./scripts/generate-migration.js",
    "debug:migrations": "node ./scripts/debug-migrations.js",
    "db:migrate": "node ./scripts/prisma.js migrate dev",
    "db:deploy": "node ./scripts/prisma.js migrate deploy",
    "db:status": "node ./scripts/prisma.js migrate status",
    "db:generate": "node ./scripts/prisma.js generate",
    "db:studio": "node ./scripts/prisma.js studio",
    "db:seed": "node ./scripts/prisma.js db seed",
    "db:format": "node ./scripts/prisma.js format",
    "db:validate": "node ./scripts/prisma.js validate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
