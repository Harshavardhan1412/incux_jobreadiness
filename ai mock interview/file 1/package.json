      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.12": true,
    "core-js@3.49.0": true,
    "esbuild@0.25.12": true
  }
}
